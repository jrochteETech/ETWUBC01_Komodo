        {
          "valueSource": "expr",
          "expression": "\"Last Time Maintenance Mode Status Was Checked : \" + now ()",
          "Maintenance_Reason": "",
          "tagGroup": "1s_Direct",
          "tagType": "AtomicTag",
          "eventScripts": [
            {
              "eventid": "valueChanged",
              "script": "\t##Define logger\n\t\tlog \u003d system.util.getLogger(\"Maintenance Mode\")\n\t\n\t\t## Define Variables\t\n\t\tEnd_Time \u003d system.tag.readBlocking(tagPath+\".Maintenance_End_Time\")[0].value\n\t\tReason \u003d system.tag.readBlocking(tagPath+\".Maintenance_Reason\" )[0].value\n\t\tcurrentMode \u003d system.tag.readBlocking( tagPath+\".Maintenance_Mode_Active\" )[0].value\n\t\tuser \u003d system.tag.readBlocking(\"[System]Client/User/Username.Value\")[0].value\n\t\t\n\t\tdiff \u003d system.date.hoursBetween(system.date.now(), system.date.parse(End_Time))\n\t\t\n\t\tdoNotOverride \u003d [\u0027dataType\u0027, \u0027enabled\u0027, \u0027engLow\u0027, \u0027expression\u0027, \u0027executionMode\u0027, \u0027historyEnabled\u0027, \u0027historyProvider\u0027, \u0027historyTagGroup\u0027, \u0027opcItemPath\u0027, \u0027opcServer\u0027, \u0027readOnly\u0027, \u0027readPermissions\u0027, \u0027sampleMode\u0027, \u0027storageProvider\u0027,\u0027tagGroup\u0027, \u0027valueSource\u0027,\u0027writePermissions\u0027]\n\t\t\n\t\t#check to if End_time is after now\n\t\tif  system.date.isAfter (system.date.parse( End_Time), system.date.now()):\n\t\t\t## if more than 8 hours selected, set end time to max 8 hours\n\t\t\tif diff \u003e 8:\n\t\t\t\tsystem.tag.writeBlocking(tagPath+\".Maintenance_End_Time\",system.date.addHours(system.date.now(), 8))\n\t\t\t\tEnd_Time \u003d system.tag.readBlocking( tagPath+\".Maintenance_End_Time\" )\n\t\t\t\t\n\t\t\t#initiate maintenance mode\t \n\t\t\tif currentMode \u003d\u003d False:\n\t\t\t\tsystem.tag.writeBlocking( tagPath+\".Maintenance_Mode_Active\" , True )\n\t\t\t\t\n\t\t\t\t#log action to logger and audit log\n\t\t\t\tlog.info(\"Maintenance Mode Active: %s, User: %s, Reason: %s\" %(tagPath, user, Reason))\n\t\t\t\t\n\t\t\t\tx \u003d system.tag.browse(tagPath.split(\"/Config\")[0],filter \u003d {\u0027tagType\u0027:\u0027AtomicTag\u0027,\"recursive\":True})\n\t\t\t\t\n\t\t\t\t#get all alarm paths\n\t\t\t\talarmsList \u003d []\n\t\t\t\tfor i in x:\n\t\t\t\t\tif \"alarm\" in str(i[\u0027attributes\u0027]):\n\t\t\t\t\t\talarms \u003d system.tag.readBlocking(str(i[\u0027fullPath\u0027])+\".Alarms\")[0].value.getDefinitions()\n\t\t\t\t\t\tfor t in alarms:\n\t\t\t\t\t\t\talarmsList.append(str(i[\u0027fullPath\u0027])+\"/Alarms/\" + str(t)+\".Priority\")\n\t\t\t\treads \u003d system.tag.readBlocking(alarmsList)\n\t\t\t\t\n\t\t\t\t#get all priorities\n\t\t\t\tpriorities \u003d []\n\t\t\t\tfor i in range(len(reads)):\n\t\t\t\t\tpriorities.append({str(alarmsList[i]):reads[i].value})\n\t\t\t\t\tconfigPath \u003d  alarmsList[i].rsplit(\"/Alarms/\",1)[0]\n\t\t\t\t\ttagConfig \u003d system.tag.getConfiguration(configPath,True)\n\t\t\t\t\t#update priority to diagnostic\n\t\t\t\t\tfor i in tagConfig[0][\u0027alarms\u0027]:\n\t\t\t\t\t\ti.update({\u0027priority\u0027:\"Diagnostic\"})\n\t\t\t\t\t#do not override certain properities\t\n\t\t\t\t\tfor k in doNotOverride:\n\t\t\t\t\t\tif k in tagConfig[0].keys():\n\t\t\t\t\t\t\ttagConfig[0].pop(k)\t\t\n\t\t\t\t\t#write back to tag\n\t\t\t\t\tsystem.tag.configure(configPath.rsplit(\"/\",1)[0], tagConfig,\"m\")\n\t\t\t\tsystem.tag.writeBlocking(tagPath+\".Alarm_Priority_Array\", system.util.jsonEncode(priorities))\n\t\t\t\t\n\t#\t\t\tfor i in alarmsList:\n\t#\t\t\t\taaPath \u003d str(i).rsplit(\"/Alarms/\",1)[0]+\".AlarmEvalEnabled\"\n\t#\t\t\t\tif system.tag.writeBlocking(aaPath,False) \u003d\u003d 2:\n\t#\t\t\t\t\tsystem.tag.writeBlocking(aaPath,True)\t\n\t\t\t\t\n\t\t\t\t#record priorities in logger\t\t\t\t\n\t\t\t\tlog.info(\"Maintenance Mode Stored Piorities: Stored Priorites: %s\" %(str(priorities)))\n\t\t\t\tsystem.util.audit(action \u003d \"Maintenance Mode Activated. Reason: \"+ Reason, actionTarget \u003d tagPath)\n\t\t\n\t\t#check if End_Time is before now. Mainteance mode should deactivate.\t\t\n\t\telif system.date.isBefore(system.date.parse( End_Time), system.date.now()):\n\t\t\n\t\t\t#change mode to false\n\t\t\tif currentMode \u003d\u003d True: \n\t\t\t\tsystem.tag.writeBlocking( tagPath+\".Maintenance_Mode_Active\" , False )\n\t\t\t\tx \u003d system.tag.browse(tagPath.split(\"/Config\")[0],filter \u003d {\u0027tagType\u0027:\u0027AtomicTag\u0027,\"recursive\":True})\n\t\t\t\talarmsList \u003d system.tag.read(tagPath+\".Alarm_Priority_Array\").value\n\t\t\t\t\n\t\t\t\t#write back to alarms the correct priority\n\t\t\t\tfor alarm in x:\n\t\t\t\t\tif \"alarm\" in str(alarm[\u0027attributes\u0027]):\n\t\t\t\t\t\ttagConfig \u003d system.tag.getConfiguration(alarm[\u0027fullPath\u0027], True)\n\t\t\t\t\t\tfor i in tagConfig[0].get(\u0027alarms\u0027):\n\t\t\t\t\t\t\tt \u003d str(alarm[\u0027fullPath\u0027]) +\"/Alarms/\"+ str(i[\u0027name\u0027]+\".Priority\")\n\t\t\t\t\t\t\tfor match in alarmsList:\n\t\t\t\t\t\t\t\tif t in match.keys():\n\t\t\t\t\t\t\t\t\ti.update({\u0027priority\u0027:match.get(t,t)})\n\t\t\t\t\t\tbasePath \u003d str(alarm[\u0027fullPath\u0027]).rsplit(\"/\",1)[0]+\u0027/\u0027\n\t\t\t\t\t\t\n\t\t\t\t\t\t#do not override certain properities\t\n\t\t\t\t\t\tfor k in doNotOverride:\n\t\t\t\t\t\t\tif k in tagConfig[0].keys():\n\t\t\t\t\t\t\t\ttagConfig[0].pop(k)\n\t\t\t\t\t\t\n\t\t\t\t\t\t#write back to tag the dictionary of changes\n\t\t\t\t\t\tsystem.tag.configure(basePath, tagConfig)\n\t#\t\t\t\t\taaPath \u003d str(alarm[\u0027fullPath\u0027]) + \".AlarmEvalEnabled\"\n\t#\t\t\t\t\tif system.tag.write(aaPath,False) \u003d\u003d 2:\n\t#\t\t\t\t\t\tsystem.tag.write(aaPath,True)\t\n\t\t\t\tsystem.tag.writeBlocking( tagPath+\".Maintenance_Reason\" , \"\" )\n\t\t\t\t\n\t\t\t\t#record to logger and audit log that maitnenance mde has deactivated\n\t\t\t\tlog.info(\"Maintenance Mode Deactivated: %s\" %(tagPath))\n\t\t\t\tsystem.util.audit(action \u003d \"Maintenance Mode Deactivated\", actionTarget \u003d tagPath)"
            }
          ],
          "Display_Type": "Maintenance_1v0",
