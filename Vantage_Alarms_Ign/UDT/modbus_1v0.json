          "eventScripts": [
            {
              "eventid": "valueChanged",
              "script": "\n\t# If the value has changed\n\tif previousValue !\u003d currentValue and initialChange \u003d\u003d False:\n\t\t#Define the logger\n\t\tlogger \u003d system.util.getLogger(\u0027OOS Parent-Child Tag Change Event Script\u0027)\n\t\t\n\t\t#Get the value of the isParent parameter\n\t\tisParent \u003d tag[\u0027parameters\u0027][\u0027isParent\u0027]\n\t\t#Only execute if isParent parameter is set to one\n\t\tif isParent:\n\t\t\t\n\t   \t\t# Extract the parent UDT path\n\t\t\tparent_udt_path \u003d \"/\".join(tagPath.split(\"/\")[:-3])\n\t\t\t#print parent_udt_path\n\t\t\t\n\t\t\t# Browse the tags recursively to find the child OOS tag\n\t\t\tresults \u003d system.tag.browse(parent_udt_path, {\"name\": \"OOS\", \"recursive\": True, \"valueSource\":\"memory\"})\n\t\t\t\n\t\t\t#Empty lists for tag paths and values\n\t\t\tpaths \u003d []\n\t\t\tvalue \u003d []\n\t\t\t# Write the current value to each found child tag\n\t\t\tfor result in results.getResults():\n\t\t\t\ttagPath\u003d str(result[\u0027fullPath\u0027])\n\t\t\t\t#Make a list of all the tag paths\n\t\t\t\tpaths.append(tagPath)\n\t\t\t\t\n\t\t\t\t#Make a list of all the values\n\t\t\t\tvalue.append(currentValue)\n\t\t\t\n\t\t\t#Use write blocking fucntion to write to a block of the tags\n\t\t\tsystem.tag.writeBlocking(paths, value)\n\t\t\tlogger.info(\"Script Executed successfully!\")\n"
            }
          ],
          "dataType": "Boolean",
