              "eventid": "valueChanged",
              "script": "\t\n\tUDTPath \u003d str.replace(str(tagPath),\"/Config/CX/CX_Data_Update\",\"\")\n\n\t\n\tCX_Data \u003d system.dataset.toPyDataSet(system.tag.readBlocking(UDTPath+\"/Config/CX/CX_Data\")[0].value) ## Pydataset\n\t\n\t#Calculate Stats \n\t\n\tTotal_Tags \u003d len(CX_Data)\n\t#print Total_Tags \n\t\n\tPercent_Tested \u003d 0 #\n\tTested_Good \u003d 0   #\n\tTested_Bad \u003d 0   #\n\tTotal_Tested \u003d 0  #\n\tUntested \u003d 0     #\n\tUntestable \u003d 0\n\tReported_Issues \u003d 0\n\t\n\tfor row in CX_Data :\n\t \n\t\n\t\tif \"Bad\" \u003d\u003d str(row[1]) :\n\t\t\tTested_Bad +\u003d1\n\t\t\t\n\t\tif \"Bad - Reported Issue\" \u003d\u003d str(row[1]) :\n\t\t\tTested_Bad +\u003d1\t\n\t\t\tReported_Issues +\u003d1\n\t\t\t\n\t\tif \"Good\" \u003d\u003d str(row[1]) :\n\t\t\tTested_Good +\u003d1\n\t\t\t\n\t\tif \"Good - Reported Issue\" \u003d\u003d str(row[1]) :\n\t\t\tTested_Good +\u003d1\t\n\t\t\tReported_Issues +\u003d1\n\t\t\t\n\t\tif \"Untested\" \u003d\u003d str(row[1]) :\n\t\t\tUntested +\u003d1\n\t\t\t\n\t\tif \"Untested - Reported Issue\" \u003d\u003d str(row[1]) :\n\t\t\tUntested +\u003d1\t\n\t\t\tReported_Issues +\u003d1\t\t\t\t\n\t\t\n\t\tif \"Untestable\" \u003d\u003d str(row[1]) :\n\t\t\tUntestable +\u003d1\n\t\n\t\tif \"Untestable - Reported Issue\" \u003d\u003d str(row[1]) :\n\t\t\tUntestable +\u003d1\t\n\t\t\tReported_Issues +\u003d1\n\n\t\n\tTotal_Tested \u003d int(Tested_Good + Tested_Bad)\n\tPercent_Tested \u003d int(float(Total_Tested)/(float(Total_Tags) - float( Untestable)) *100)\n\tPercent_Tested_Good \u003d int(float(Tested_Good)/(float(Total_Tags) - float( Untestable)) *100)\n\t\n\t# Write Stats\n\t\n\tsystem.tag.writeBlocking(UDTPath+\"/Config/CX/CX_Data.Total\" , Total_Tags)\n\tsystem.tag.writeBlocking(UDTPath+\"/Config/CX/CX_Data.Tested_Good\" , Tested_Good)\n\tsystem.tag.writeBlocking(UDTPath+\"/Config/CX/CX_Data.Tested_Bad\" , Tested_Bad)\n\tsystem.tag.writeBlocking(UDTPath+\"/Config/CX/CX_Data.Untested\" , Untested)\n\tsystem.tag.writeBlocking(UDTPath+\"/Config/CX/CX_Data.Untestable\" , Untestable)\n\tsystem.tag.writeBlocking(UDTPath+\"/Config/CX/CX_Data.Total_Tested\" , Total_Tested)\n\tsystem.tag.writeBlocking(UDTPath+\"/Config/CX/CX_Data.Percent_Tested\" , Percent_Tested)\n\tsystem.tag.writeBlocking(UDTPath+\"/Config/CX/CX_Data.Percent_Tested_Good\" , Percent_Tested_Good)"
            }
